<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog
		id="distributionSelectDialog"
		title="Distribution Channels"
		items="{BaseModel>/DistChannel}"
		search=".onSearch"
		confirm=".onDistValueHelpClose">
		<StandardListItem
			icon=""
			iconDensityAware="false"
			iconInset="false"
			title="{BaseModel>ChannelName}"
			description="{BaseModel>DistributionChannel}" />
	</SelectDialog>
</core:FragmentDefinition>