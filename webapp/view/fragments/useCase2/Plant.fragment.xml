<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog
		id="plantDialog"
		title="Divisions"
		items="{BaseModel>/Plant}"
		search=".onSearch"
		confirm=".onPlantValueHelpClose">
		<StandardListItem
			icon=""
			iconDensityAware="false"
			iconInset="false"
			title="{BaseModel>PlantName}"
			description="{BaseModel>Plant}" />
	</SelectDialog>
</core:FragmentDefinition>