<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<SelectDialog
		id="offeringSelectDialog"
		title="Offerings"
		items="{BaseModel>/Offerings}"
		search=".onSearch"
		confirm=".onOfferingValueHelpClose">
		<StandardListItem
			icon=""
			iconDensityAware="false"
			iconInset="false"
			title="{BaseModel>OfferingId}"
			description="{BaseModel>OfferingName}" />
	</SelectDialog>
</core:FragmentDefinition>